# 이 파일을 .env 로 복사한 뒤 값을 채우세요: cp .env.example .env

# 공공데이터포털(data.go.kr) 인증키 (일반 인증키 Decoding 값)
# 활용신청: "한국부동산원_주택청약 분양정보 조회 서비스"
CHEONGYAK_SERVICE_KEY=

# @BotFather 로 봇 생성 후 받은 토큰 (예: 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# 리포트를 받을 채팅방 ID (python3 cheongyak_report.py --get-chat-id 로 확인)
TELEGRAM_CHAT_ID=

# 지역 필터. 비워두면 전국. 예: AREA_FILTER=서울,경기,인천
AREA_FILTER=

# 새 소식이 없는 날에도 "소식 없음" 메시지를 보낼지 (true/false)
SEND_WHEN_EMPTY=true
